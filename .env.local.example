# Supabase → Project Settings → API (or "Connect")
# These two are PUBLIC by design (safe in the browser). Security comes from RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# NEVER add the service_role / secret key anywhere in this app.

# Your UPI ID shown on the register page (public, optional)
NEXT_PUBLIC_UPI_ID=yourname@upi
